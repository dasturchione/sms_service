# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database
DB_CONNECTION=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# Gateway node
# NODE_ID=node-1
GATEWAY_NODE_ENABLED=true

# Background jobs (webhook delivery, stats rollup, balance alerts)
WORKER_ENABLED=true
# WEBHOOK_TIMEOUT_MS=10000

# Monitoring
# Bearer token guarding /metrics. Leave unset only if it is not reachable
# from outside the cluster.
# METRICS_TOKEN=
