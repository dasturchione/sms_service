SESSION_DRIVER=memory

# Tests run against a dedicated database so a suite that truncates tables can
# never wipe development data.
DB_DATABASE=smsservice_test

# Tests drive the dispatcher explicitly, so the background loop stays off.
GATEWAY_NODE_ENABLED=false

# Same reasoning for the job runner and the periodic tasks: a test that races a
# timer passes on a fast machine and fails on a slow one. Tests call the
# handlers directly.
WORKER_ENABLED=false
